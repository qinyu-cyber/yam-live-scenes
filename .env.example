# Inworld — platform.inworld.ai (Base64 "key:secret" for Basic auth, or raw API key)
INWORLD_API_KEY=your-inworld-api-key

# Tenstorrent Cloud — console.tenstorrent.com (Bearer token; serves inworld-tts-2, prebake only)
TENSTORRENT_API_KEY=your-tenstorrent-api-key

# Anthropic — console.anthropic.com (branch-writer LLM)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Inworld LLM Router model for the fast branch lane.
# Default is openai/gpt-4o-mini (free tier). With billing enabled on your
# Inworld account, prefer: google-ai-studio/gemini-3.1-flash
# INWORLD_ROUTER_MODEL=google-ai-studio/gemini-3.1-flash
